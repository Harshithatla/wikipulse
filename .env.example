# --- source ------------------------------------------------------------------
# synthetic = offline demo with injected edit storms; wikimedia = the live global stream
WIKIPULSE_SOURCE=synthetic
# Wikimedia asks clients to identify themselves (User-Agent). Put an email or repo URL here.
WIKIPULSE_CONTACT=
# Limit to these wikis (comma-separated). Excluding wikidatawiki/commonswiki keeps volume
# comfortably inside the free tier. Empty = every wiki.
WIKI_ALLOWLIST=enwiki,dewiki,frwiki,eswiki,itwiki,jawiki,ptwiki,ruwiki
SYNTHETIC_RATE=50
# one synthetic edit storm every N events (6000 at 50 msg/s = about every 2 minutes)
SYNTHETIC_STORM_EVERY=6000

# --- streaming ---------------------------------------------------------------
TRIGGER_SECONDS=60
STORM_MIN_EDITS=15
STORM_MIN_EDITORS=5

# --- GCP (filled by `make env` from terraform outputs) -------------------------
WIKIPULSE_GCP_PROJECT=
WIKIPULSE_BUCKET=
WIKIPULSE_BQ_LOCATION=us-central1
# DAGs don't schedule runs before this (UTC). Set it to roughly "now" on first start.
WIKIPULSE_START=2026-11-12T00:00:00
